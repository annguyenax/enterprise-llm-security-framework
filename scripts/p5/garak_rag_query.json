{
  "rest": {
    "RestGenerator": {
      "name": "shield-ai-rag-query",
      "uri": "http://127.0.0.1:8089/v1/rag/query",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "query": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "answer",
      "request_timeout": 60,
      "skip_codes": [400, 422]
    }
  }
}
