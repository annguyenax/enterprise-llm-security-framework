{
  "rest": {
    "RestGenerator": {
      "name": "shield-ai-gateway-chat",
      "uri": "http://127.0.0.1:8089/v1/gateway/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "prompt": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "response",
      "request_timeout": 60,
      "skip_codes": [400, 422]
    }
  }
}
