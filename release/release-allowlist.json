{
  "schema_version": 2,
  "policy_id": "phase12g-release-allowlist-v2",
  "fail_closed": true,
  "source_of_truth": "git ls-files (tracked) plus an explicit operator-supplied generated-file allowlist; ignored files are never packaged by discovery",
  "prohibited": {
    "extensions": [
      ".jsonl",
      ".db",
      ".sqlite",
      ".sqlite3",
      ".pem",
      ".key",
      ".p12",
      ".pfx"
    ],
    "exact_names": [
      "result.json",
      "credentials.json",
      "credential.json",
      "secrets.json",
      "id_rsa",
      "id_ed25519"
    ],
    "env": {
      "prohibit_dotenv": true,
      "allow_exceptions": [
        ".env.example",
        ".env.sample",
        ".env.template"
      ]
    },
    "path_components": [
      ".git",
      ".venv",
      "venv",
      "env",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "node_modules",
      ".idea",
      ".vscode",
      ".tmp",
      ".pytest-tmp"
    ]
  },
  "required_present": [
    "datasets/v2/manifests/benchmark-v2-manifest.json",
    "redteam/prompts-manifest.json",
    "release/release-allowlist.json",
    "release/release-policy.md"
  ],
  "optional_generated": {
    "allowed": true,
    "note": "Operator-supplied generated files, each pinned by SHA-256 and byte size, still subject to every prohibited rule above. The CLI cannot broaden the prohibited classification."
  }
}
